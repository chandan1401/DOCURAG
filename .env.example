# ==============================================================================
# DocuRAG Environment Configuration
# ==============================================================================

# LLM & Vision (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage & Paths
DOCURAG_STORAGE=./storage

# Embeddings & Reranking Models
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# Ingestion & Vision Thresholds
OCR_MIN_CHARS=50
RENDER_DPI=200
MIN_IMG_PX=150

# Chunking Configuration
CHUNK_TOKENS=400
CHUNK_OVERLAP=50

# Retrieval & Fusion Parameters
DENSE_K=30
BM25_K=30
RERANK_IN=20
FINAL_K=6
RRF_K=60

# Verification & Answerability Thresholds
SUPPORT_THRESHOLD=0.7

# Multi-Agent Runtime & Mode Flags
USE_AGENTS=false
MCP_MODE=direct
DOCURAG_FAKES=0

# Colab / Tunneling (Optional)
NGROK_AUTHTOKEN=

# Optional fallback LLM (NVIDIA)
NVIDIA_API_KEY=
